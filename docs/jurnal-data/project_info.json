{
  "project": "BISINDO Bridge",
  "description": "Real-time Indonesian Sign Language (BISINDO) alphabet recognition",
  "models": {
    "cnn_2hand": {
      "role": "MAIN - deployed model",
      "input_dim": 84,
      "features": "21 landmarks \u00d7 2 coords (x,y) \u00d7 2 hands",
      "dataset": "landmarks_2hands.csv (26,192 rows, 1000 per letter)",
      "accuracy": 0.9845,
      "f1": 0.9845,
      "test_samples": 3929,
      "split": "85/15 stratified, random_state=42",
      "training_time_s": 152.77,
      "architecture": {
        "type": "1D-CNN",
        "conv_blocks": [
          {
            "filters": 64,
            "kernel": 3,
            "padding": 1,
            "activation": "ReLU",
            "pool": "MaxPool1d(2)"
          },
          {
            "filters": 128,
            "kernel": 3,
            "padding": 1,
            "activation": "ReLU",
            "pool": "MaxPool1d(2)"
          },
          {
            "filters": 64,
            "kernel": 3,
            "padding": 1,
            "activation": "ReLU",
            "pool": "AdaptiveAvgPool1d(1)"
          }
        ],
        "flatten": 64,
        "fc": [
          {
            "in": 64,
            "out": 128,
            "activation": "ReLU",
            "dropout": 0.3
          },
          {
            "in": 128,
            "out": 26
          }
        ],
        "output": "Softmax 26 classes (A-Z)",
        "total_params": "~30K"
      },
      "hyperparameters": {
        "optimizer": "Adam",
        "lr": 0.001,
        "batch_size": 256,
        "epochs": 50,
        "loss": "CrossEntropyLoss",
        "dropout": 0.3,
        "seed": 42
      },
      "onnx": {
        "input_shape": [
          "batch_size",
          1,
          84
        ],
        "output_shape": [
          "batch_size",
          26
        ],
        "file": "meeting/static/models/model.onnx",
        "size_kb": 241,
        "runtime": "onnxruntime-web@1.17.1",
        "conversion": "torch.onnx.export, opset 12",
        "verified_match": "max diff < 0.000004 vs PyTorch"
      },
      "deployed": true,
      "re_evaluated": true,
      "re_eval_matches_training": true
    },
    "cnn_balanced": {
      "role": "Baseline/comparison - best accuracy but single-hand only",
      "input_dim": 63,
      "features": "21 landmarks \u00d7 3 coords (x,y,z) \u00d7 1 hand",
      "dataset": "landmarks_balanced.csv (208,000 rows, 8000 per letter)",
      "accuracy": 0.9912,
      "f1": 0.9912,
      "training_time_s": 3703.84,
      "training_time_human": "~62 minutes CPU",
      "architecture": {
        "type": "1D-CNN",
        "conv_blocks": [
          {
            "filters": 64,
            "kernel": 3,
            "padding": 1,
            "activation": "ReLU",
            "pool": "MaxPool1d(2)"
          },
          {
            "filters": 128,
            "kernel": 3,
            "padding": 1,
            "activation": "ReLU",
            "pool": "MaxPool1d(2)"
          },
          {
            "filters": 64,
            "kernel": 3,
            "padding": 1,
            "activation": "ReLU",
            "pool": "AdaptiveAvgPool1d(8)"
          }
        ],
        "flatten": 512,
        "fc": [
          {
            "in": 512,
            "out": 128,
            "activation": "ReLU",
            "dropout": 0.3
          },
          {
            "in": 128,
            "out": 26
          }
        ],
        "output": "Softmax 26 classes"
      },
      "deployed": false,
      "re_evaluated": false,
      "re_eval_note": "Cannot re-evaluate from current codebase - preprocessing differs from training. Numbers from training-time metrics."
    }
  },
  "normalization": {
    "step1": "Translate to wrist (landmark 0 as origin) - position invariance",
    "step2": "Scale by max distance from wrist - size/distance invariance",
    "step3": "StandardScaler (zero mean, unit variance) - saved per model as scaler.json"
  },
  "mediapipe": {
    "version": "@mediapipe/tasks-vision@0.10.35",
    "model": "hand_landmarker float16",
    "model_url": "https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task",
    "num_hands": 2,
    "landmarks_per_hand": 21,
    "coords_used_deployed": "x, y (2D, no depth)",
    "coords_used_balanced": "x, y, z (3D with depth)"
  },
  "deployment": {
    "web": "web/ - standalone demo, Vercel-deployable",
    "meeting": "meeting/ - Flask-SocketIO + WebRTC mesh + ONNX inference",
    "onnx_files": {
      "model": "meeting/static/models/model.onnx (241KB) + web/models/model.onnx",
      "scaler": "meeting/static/models/scaler.json (3.3KB, 84 features)",
      "labels": "meeting/static/models/labels.json (130B, 26 classes A-Z)"
    },
    "inference_flow": [
      "MediaPipe detect hands -> 21 landmarks per hand (x,y)",
      "landmarksToFeatures(): flatten to 84 (hand1 xy 42 + hand2 xy 42, zero-pad if 1 hand)",
      "normalizeFeaturesHandCentric(): translate to wrist + scale by hand size per hand",
      "scaleFeatures(): StandardScaler (mean/scale from scaler.json)",
      "predictModel(): ONNX inference -> softmax -> letter + confidence"
    ],
    "privacy": "All inference local in browser, no data leaves device"
  },
  "dataset": {
    "canonical": {
      "file": "landmarks_captured_v2.csv",
      "rows": 138471,
      "classes": 26,
      "columns": 68,
      "contributors": 9,
      "top_contributors": {
        "Jouxing": "24.8%",
        "Kevin": "23.3%",
        "felis": "23.2%"
      },
      "bias_note": "Top-3 produce 71% of samples"
    },
    "two_hand": {
      "file": "landmarks_2hands.csv",
      "rows": 26192,
      "classes": 26,
      "per_class": 1000,
      "columns": 89,
      "note": "Balanced, 1000 per letter"
    }
  }
}